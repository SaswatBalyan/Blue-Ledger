<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 
        Splash Screen Typography Styles
        Matches Figma specifications exactly
    -->
    
    <!-- Main title "BLUE LEDGER" - Koulen Bold, responsive sizing, color #0B3042 -->
    <!-- TODO: Add koulen.ttf to res/font/ and uncomment fontFamily -->
    <style name="blue_ledger">
        <item name="android:textSize">@dimen/title_text_size</item>
        <item name="android:textColor">#0B3042</item>
        <!-- <item name="android:fontFamily">@font/koulen</item> -->
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">0sp</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>
    
    <!-- Tagline "minting a better future" - La Belle Aurore Regular, responsive sizing, color #2494C3 -->
    <!-- TODO: Add la_belle_aurore.ttf to res/font/ and uncomment fontFamily -->
    <style name="minting_a_b">
        <item name="android:textSize">@dimen/tagline_text_size</item>
        <item name="android:textColor">#2494C3</item>
        <!-- <item name="android:fontFamily">@font/la_belle_aurore</item> -->
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">italic</item>
        <item name="android:lineSpacingExtra">0sp</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>
    
    <!-- Continue button text - Rubik Medium, responsive sizing, color #0B3042 -->
    <!-- TODO: Add rubik_medium.ttf to res/font/ and uncomment fontFamily -->
    <style name="continue_text_style">
        <item name="android:textSize">@dimen/continue_text_size</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">#0B3042</item>
        <!-- <item name="android:fontFamily">@font/rubik</item> -->
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineSpacingExtra">0sp</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>

    <!-- Onboarding Screen Styles -->
    <style name="welcome_">
        <item name="android:textSize">59.6sp</item>
        <item name="android:textColor">#0B3042</item>
        <item name="android:fontFamily">@font/rubikmedium</item>
    </style>

    <style name="sign_up">
        <item name="android:textSize">29.39sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">#F8F8FF</item>
        <item name="android:fontFamily">@font/rubikmedium</item>
    </style>

    <style name="login">
        <item name="android:textSize">29.39sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">#F8F8FF</item>
        <item name="android:fontFamily">@font/rubikmedium</item>
    </style>

    <style name="change_lang">
        <item name="android:textSize">16.01sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">#0B3042</item>
        <item name="android:fontFamily">@font/rubikmedium</item>
    </style>
    
</resources>
